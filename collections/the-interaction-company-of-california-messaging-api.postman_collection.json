  "info": {
    "_postman_id": "f1a99383-2c6d-43fc-8c97-4e83e9c7f238",
    "name": "Poke Messaging API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Poke API lets applications and automation tools send messages to Poke programmatically. Messages are processed by Poke with access to the user's email, calendar, reminders, and connected integrations. It is designed for desktop tools, CI/CD triggers, webhooks, and bridging services that have no native Poke integration. Poke is built by The Interaction Company of California.\n\nContact Support:\n Name: Interaction Co.\n Email: hi@interaction.co",
      "type": "text/plain"
    }
  }
